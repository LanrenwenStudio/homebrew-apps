---
const CHROME_STORE = 'https://chromewebstore.google.com/detail/highlight-share/nmjdekhjdeebjbckapcpjagkjcabcgla';
---

<section id="top" class="hero-section panel-ambient">
  <div class="container-max hero-grid">
    <!-- Left Copy -->
    <div class="hero-copy">
      <div class="badge badge-amber hero-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        <span data-i18n="hero.badge">Chrome 扩展 · 划词高亮与精准直达</span>
      </div>

      <h1 class="hero-title">
        <span data-i18n="hero.titleLine1">划线高亮。</span><br />
        <span class="gradient-text" data-i18n="hero.titleLine2">精准直达。</span>
      </h1>

      <p class="hero-desc" data-i18n="hero.desc">
        在任意网页划选重点，浮动工具栏即刻高亮；侧边栏集中管理与沉淀。生成包含段落锚点的 W3C 直达链接，对方打开直接定位并高亮那句话。纯本地存储，无需账号。
      </p>

      <div class="hero-actions">
        <a href={CHROME_STORE} target="_blank" rel="noreferrer" class="btn btn-primary hero-btn-main">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="4" /><line x1="21.17" y1="8" x2="12" y2="8" /><line x1="3.95" y1="6.06" x2="8.54" y2="14" /><line x1="10.88" y1="21.94" x2="15.46" y2="14" /></svg>
          <span data-i18n="hero.installBtn">免费添加到 Chrome</span>
        </a>
        <a href="#demo" class="btn btn-secondary hero-btn-sub">
          <span data-i18n="hero.demoBtn">在下方体验 Demo</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="7" x2="17" y2="17"></line><polyline points="17 7 17 17 7 17"></polyline></svg>
        </a>
      </div>

      <ul class="hero-tags">
        <li class="hero-tag-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span data-i18n="hero.tagLocal">100% 本地存储</span>
        </li>
        <li class="hero-tag-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          <span data-i18n="hero.tagFragment">W3C Text Fragment</span>
        </li>
        <li class="hero-tag-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
          <span data-i18n="hero.tagPalette">多色调色盘</span>
        </li>
      </ul>
    </div>

    <!-- Right Live Interactive Hero Card -->
    <div class="hero-card-wrap">
      <div class="hero-card-glow"></div>
      <div class="hero-mockup-card">
        <!-- Mockup Browser Bar -->
        <div class="mock-browser-header">
          <div class="mock-dots">
            <span class="mock-dot dot-red"></span>
            <span class="mock-dot dot-yellow"></span>
            <span class="mock-dot dot-green"></span>
          </div>
          <div class="mock-url-pill">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>highlightshare.lanrenwen.com/demo</span>
          </div>
          <div class="mock-header-spacer"></div>
        </div>

        <!-- Simulated Article Excerpt with Live Toolbar -->
        <div class="hero-card-body">
          <div class="hero-prompt-bar">
            <span data-i18n="hero.tip">真实插件交互还原 · 浮动工具栏 + Text Fragment 直达链接</span>
          </div>

          <div class="hero-article-box">
            <!-- Live Floating Toolbar -->
            <div class="hero-floating-toolbar" id="heroFloatingToolbar">
              <div class="toolbar-colors">
                <button type="button" class="swatch-btn active" data-color="#facc15" style="background-color: #facc15;" title="Yellow"></button>
                <button type="button" class="swatch-btn" data-color="#4ade80" style="background-color: #4ade80;" title="Green"></button>
                <button type="button" class="swatch-btn" data-color="#38bdf8" style="background-color: #38bdf8;" title="Sky Blue"></button>
                <button type="button" class="swatch-btn" data-color="#c084fc" style="background-color: #c084fc;" title="Purple"></button>
                <button type="button" class="swatch-btn" data-color="#fb923c" style="background-color: #fb923c;" title="Orange"></button>
              </div>

              <button type="button" class="toolbar-btn" id="heroCopyLinkBtn">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="toolbar-link-icon"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="toolbar-check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span id="heroCopyLinkText">复制分享链接</span>
              </button>
            </div>

            <p class="hero-simulated-text">
              在信息过载的时代，好的阅读者不仅吸收知识，更懂得如何标记与传递。<mark class="hero-live-mark" id="heroLiveMark" style="background-color: #facc15; color: #18181b;">Highlight Share 让你在任何网页上划出那行闪光的重点，并一键生成包含段落锚点的直达链接。</mark> 接收者点击后，视口自动平滑滚动至原句并高亮闪烁，还原第一阅读现场。
            </p>
          </div>

          <!-- URL Anchor Pill -->
          <div class="hero-url-fragment-bar">
            <div class="url-left">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span class="fragment-code">#:~:text=Highlight%20Share...</span>
            </div>
            <button type="button" class="btn-copy-sm" id="heroPillCopyBtn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span id="heroPillCopyText">复制</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    padding: 3.5rem 0 4.5rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: 5.5rem 0 6.5rem;
    }
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .hero-badge {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.8vw, 4.25rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .gradient-text {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 50%, #ea580c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  [data-theme="dark"] .gradient-text {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #fb923c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    margin-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 32rem;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-btn-main {
    height: 2.75rem;
    padding: 0 1.25rem;
  }

  .hero-btn-sub {
    height: 2.75rem;
    padding: 0 1.125rem;
  }

  .hero-tags {
    margin-top: 2.5rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .hero-tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .hero-tag-item svg {
    color: var(--text-primary);
  }

  /* Right Card */
  .hero-card-wrap {
    position: relative;
    width: 100%;
  }

  .hero-card-glow {
    position: absolute;
    inset: -1.5rem;
    background: radial-gradient(circle at 60% 30%, rgba(250, 204, 21, 0.22), transparent 70%);
    border-radius: 2.5rem;
    filter: blur(28px);
    pointer-events: none;
  }

  .hero-mockup-card {
    position: relative;
    border-radius: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .mock-browser-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .mock-dots {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .mock-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
  }
  .dot-red { background-color: #f87171; }
  .dot-yellow { background-color: #fbbf24; }
  .dot-green { background-color: #34d399; }

  .mock-url-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.375rem;
    padding: 0.125rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .mock-header-spacer {
    width: 2rem;
  }

  .hero-card-body {
    padding: 1.25rem;
  }

  .hero-prompt-bar {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
  }

  .hero-article-box {
    position: relative;
    border-radius: 0.875rem;
    border: 1px solid rgba(245, 158, 11, 0.25);
    background: rgba(245, 158, 11, 0.04);
    padding: 1.25rem 1rem 1rem;
    margin-bottom: 0.875rem;
  }

  /* Floating Toolbar */
  .hero-floating-toolbar {
    position: absolute;
    top: -1.125rem;
    left: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 0.625rem;
    padding: 0.25rem 0.5rem;
    box-shadow: var(--shadow-md);
  }

  .toolbar-colors {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    padding-right: 0.375rem;
    border-right: 1px solid var(--border-subtle);
  }

  .swatch-btn {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease, outline 0.15s ease;
  }

  .swatch-btn:hover {
    transform: scale(1.25);
  }

  .swatch-btn.active {
    outline: 2px solid var(--text-primary);
    outline-offset: 1px;
  }

  .toolbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: none;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    transition: background 0.15s ease;
  }

  .toolbar-btn:hover {
    background-color: var(--bg-subtle);
  }

  .toolbar-link-icon {
    color: #d97706;
  }

  .toolbar-check-icon {
    display: none;
    color: #10b981;
  }

  .toolbar-btn.copied .toolbar-link-icon {
    display: none;
  }
  .toolbar-btn.copied .toolbar-check-icon {
    display: block;
  }

  .hero-simulated-text {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .hero-live-mark {
    border-radius: 0.25rem;
    padding: 0.0625rem 0.25rem;
    transition: background-color 0.2s ease;
  }

  /* Fragment Bar */
  .hero-url-fragment-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 0.625rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }

  .url-left {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .url-left svg {
    color: #f59e0b;
    flex-shrink: 0;
  }

  .fragment-code {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-copy-sm {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .btn-copy-sm:hover {
    background: var(--bg-hover);
  }
</style>

<script>
  // Interactive Hero Toolbar Swatches
  const swatchButtons = document.querySelectorAll('.hero-section .swatch-btn');
  const heroMark = document.getElementById('heroLiveMark');
  const heroCopyLinkBtn = document.getElementById('heroCopyLinkBtn');
  const heroCopyLinkText = document.getElementById('heroCopyLinkText');
  const heroPillCopyBtn = document.getElementById('heroPillCopyBtn');
  const heroPillCopyText = document.getElementById('heroPillCopyText');

  swatchButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      swatchButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const color = btn.getAttribute('data-color');
      if (heroMark && color) {
        heroMark.style.backgroundColor = color;
      }
    });
  });

  const DEMO_SHARE_URL = 'https://highlightshare.lanrenwen.com/demo#:~:text=Highlight%20Share%20%E8%AE%A9%E4%BD%A0%E5%9C%A8%E4%BB%BB%E4%BD%95%E7%BD%91%E9%A1%B5%E4%B8%8A%E5%88%92%E5%87%BA%E9%82%A3%E8%A1%8C%E9%97%AA%E5%85%89%E7%9A%84%E9%87%8D%E7%82%B9';

  function copyHeroUrl() {
    navigator.clipboard.writeText(DEMO_SHARE_URL).then(() => {
      if (heroCopyLinkBtn) {
        heroCopyLinkBtn.classList.add('copied');
        if (heroCopyLinkText) heroCopyLinkText.textContent = (window as any).currentLang === 'en' ? 'Link Copied!' : '已复制直达链接！';
        setTimeout(() => {
          heroCopyLinkBtn.classList.remove('copied');
          if (heroCopyLinkText) heroCopyLinkText.textContent = (window as any).currentLang === 'en' ? 'Copy Link' : '复制分享链接';
        }, 2200);
      }
      if (heroPillCopyBtn && heroPillCopyText) {
        heroPillCopyText.textContent = (window as any).currentLang === 'en' ? 'Copied' : '已复制';
        setTimeout(() => {
          if (heroPillCopyText) heroPillCopyText.textContent = (window as any).currentLang === 'en' ? 'Copy' : '复制';
        }, 2200);
      }
      const toast = document.getElementById('toastNotice');
      if (toast) {
        const msg = (window as any).currentLang === 'en' ? '✨ Deep link copied to clipboard!' : '✨ 已复制精准直达链接！';
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2400);
      }
    }).catch(() => {});
  }

  heroCopyLinkBtn?.addEventListener('click', copyHeroUrl);
  heroPillCopyBtn?.addEventListener('click', copyHeroUrl);
</script>
