---
---

<section class="interactive-section" id="interactive">
  <div class="container">
    <div class="demo-wrapper">
      <!-- Left: Mac Popover -->
      <div class="mac-popover">
        <div class="popover-header">
          <span class="popover-title" data-i18n="demo.title">鼠标中键修改器</span>
          <div class="popover-header-actions">
            <div id="statusCapsule" class="status-capsule">
              <span class="status-dot"></span>
              <span id="statusText" data-i18n="badge.listening">监听中</span>
            </div>
            <button class="power-btn" aria-label="Quit">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                <line x1="12" y1="2" x2="12" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Target Key Card -->
        <div class="popover-card">
          <div class="card-top">
            <span class="card-label" data-i18n="demo.targetKey">映射按键</span>
            <button id="resetBtn" class="card-reset" data-i18n="demo.reset">重置</button>
          </div>

          <div id="keyDisplayBox" class="key-display-box" title="点击切换演示按键">
            <div class="key-main">
              <span>⌨️</span>
              <span id="targetKeyText">Right Control</span>
            </div>
            <span class="key-edit-tag" data-i18n="demo.change">修改</span>
          </div>

          <div class="card-hint" data-i18n="demo.hint">按下鼠标中键即可触发</div>
        </div>

        <!-- Launch At Login Card -->
        <div class="popover-card login-card">
          <div class="login-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="login-info">
            <div class="login-title" data-i18n="demo.autostart">开机自启动</div>
            <div class="login-desc" data-i18n="demo.autostartDesc">登录后在后台静默运行</div>
          </div>
          <div class="switch-mock">
            <div class="switch-knob"></div>
          </div>
        </div>
      </div>

      <!-- Right: Mouse Simulator Visual -->
      <div class="mouse-simulator-area">
        <div class="mouse-visual-container">
          <div class="mouse-seam"></div>
          <div id="mouseRays" class="mouse-rays">
            <div class="ray ray-left"></div>
            <div class="ray ray-mid"></div>
            <div class="ray ray-right"></div>
          </div>
          <button id="mouseWheelBtn" class="mouse-wheel-btn" title="点击模拟中键按下">
            MID
          </button>
        </div>
        <p class="interactive-tip" data-i18n="demo.interactiveTip">
          💡 试试在上方鼠标模型上点击鼠标中键（滚轮），体验实时触发与按键响应！
        </p>
      </div>
    </div>
  </div>
</section>
