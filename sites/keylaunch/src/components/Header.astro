---
---
<header class="nav">
  <div class="nav-inner shell">
    <a class="brand" href="#top" aria-label="KeyLaunch 首页">
      <img src="/assets/keylaunch-icon.webp" class="brand-logo-img" alt="KeyLaunch Logo" width="28" height="28" />
      <div class="brand-text">
        <span>KeyLaunch</span>
        <span class="brand-sub" data-i18n="brand.sub">键启</span>
        <span class="brand-version">v1.3.18</span>
      </div>
    </a>
    <nav class="nav-links" aria-label="主导航">
      <a href="#features" data-i18n="nav.features">功能特性</a>
      <a href="#comparison" data-i18n="nav.comparison">为什么选它</a>
      <a href="#hud" data-i18n="nav.hud">HUD 地图</a>
      <a href="#specs" data-i18n="nav.specs">技术指标</a>
      <a href="#install" data-i18n="nav.install">获取安装</a>
      <a href="#faq" data-i18n="nav.faq">常见问题</a>
    </nav>
    <div class="nav-actions">
      <label class="language-picker">
        <select id="languageSelect" aria-label="切换语言">
          <option value="zh-Hans" selected>简体中文</option>
          <option value="zh-Hant">繁體中文</option>
          <option value="en">English</option>
          <option value="ja">日本語</option>
          <option value="ko">한국어</option>
        </select>
      </label>
      <button type="button" class="nav-brew-btn" data-copy="brew install --cask LanrenwenStudio/apps/key-launch" aria-label="复制 Homebrew 安装命令">
        <span class="nav-brew-emoji">🍺</span>
        <span>Homebrew</span>
      </button>
    </div>
  </div>
</header>
