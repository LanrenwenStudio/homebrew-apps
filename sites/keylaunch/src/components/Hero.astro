---
import KeyboardSimulator from './KeyboardSimulator.astro';
---

<section class="hero-section shell">
  <div class="hero-content">
    <div class="hero-badge" data-i18n="hero.badge">
      原生 macOS 键盘启动神器 · v1.3.18 (33)
    </div>
    <h1 class="hero-title" data-i18n-html="hero.title">
      把常用的 App，<br><span>变成手指的下意识反应。</span>
    </h1>
    <p class="hero-lede" data-i18n="hero.lede">
      告别在 Dock 里翻找和不断轮询 Cmd+Tab。按下修饰键 + 单个字母，0.1 秒直达任何 App；再次按下，即刻去回弹跳切换。
    </p>

    <!-- Download Options Matrix -->
    <div class="cta-matrix">
      <!-- 1. Homebrew Cask (Recommended) -->
      <button type="button" class="cta-card cta-brew" data-copy="brew install --cask LanrenwenStudio/apps/key-launch" aria-label="复制 Homebrew 安装命令">
        <div class="cta-card-header">
          <span class="cta-label" data-i18n="hero.brewLabel">Homebrew Cask</span>
          <span class="cta-pill" data-i18n="hero.brewTag">🍺 极速推荐</span>
        </div>
        <div class="cta-code-row">
          <code>brew install key-launch</code>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
        </div>
      </button>

      <!-- 2. Direct DMG Download -->
      <a class="cta-card" id="downloadDmgBtn" href="https://github.com/LanrenwenStudio/homebrew-apps/releases/download/key-launch-v1.3.18/key-launch-1.3.18.dmg" download>
        <div class="cta-card-header">
          <span class="cta-label" data-i18n="hero.directLabel">官网直链</span>
          <span class="cta-pill cta-pill-blue">DMG</span>
        </div>
        <div class="cta-title-row">
          <span data-i18n="hero.direct">下载安装包 (v1.3.18)</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </div>
      </a>

      <!-- 3. Mac App Store -->
      <a class="cta-card" data-app-store-link href="https://apps.apple.com/app/keylaunch/id6742337775" target="_blank" rel="noopener noreferrer">
        <div class="cta-card-header">
          <span class="cta-label" data-i18n="hero.available">Mac App Store</span>
          <span class="cta-pill cta-pill-store">App Store</span>
        </div>
        <div class="cta-title-row">
          <span data-i18n="hero.storeSub">前往商店安装</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </div>
      </a>
    </div>

    <p class="hero-reqs" data-i18n="hero.requirements">
      支持 macOS 13 (Ventura) 及以上 · Apple 芯片与 Intel 架构 · 100% 本地隐私安全
    </p>
  </div>

  <!-- Interactive Keyboard Simulator -->
  <div class="simulator-wrapper">
    <div class="simulator-tip-card">
      <div class="tip-badge">
        <span class="tip-pulse-dot"></span>
        <span class="tip-badge-text" data-i18n="simulator.badge">交互仿真</span>
      </div>
      <div class="simulator-tip-text">
        <span data-i18n="simulator.hint">可在实体键盘上直接敲击按键（如 W, E, F, G, C, X），或点击下方键帽体验极速切换与弹跳机制</span>
      </div>
    </div>
    <KeyboardSimulator />
  </div>
</section>
