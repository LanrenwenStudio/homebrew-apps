<section class="dna-section shell reveal" id="specs">
  <div class="section-head">
    <span class="section-eyebrow" data-i18n="dna.eyebrow">原生架构基因</span>
    <h2 class="section-title" data-i18n="dna.title">轻巧极速、纯正原生、绝对隐私。</h2>
  </div>

  <div class="dna-grid">
    <div class="dna-card">
      <div class="dna-val">0.1s</div>
      <div class="dna-label" data-i18n="dna.speed.desc">瞬时唤醒与去回响应</div>
    </div>
    <div class="dna-card">
      <div class="dna-val">&lt;20MB</div>
      <div class="dna-label" data-i18n="dna.mem.desc">常驻内存极其轻巧</div>
    </div>
    <div class="dna-card">
      <div class="dna-val">100%</div>
      <div class="dna-label" data-i18n="dna.privacy.desc">本地运行，0 网络上报</div>
    </div>
    <div class="dna-card">
      <div class="dna-val">8</div>
      <div class="dna-label" data-i18n="dna.lang.desc">原生多语言全覆盖</div>
    </div>
  </div>
</section>
