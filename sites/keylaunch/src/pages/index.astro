                <div class="df-info"><strong>KeyLaunch_Architecture_2026.pdf</strong><span>Synced today at 2:20 PM</span></div>
              </div>
              <div class="drive-file-item">
                <span class="df-icon">📦</span>
                <div class="df-info"><strong>Studio_Assets_Master.sketch</strong><span>Synced yesterday at 7:45 PM</span></div>
              </div>
            </div>
          </div>
        `;
      }

      // Generic fallback
      return `
        <div class="fake-browser-content" style="width:100%;">
          <div class="fake-app-avatar" style="width:48px;height:48px;margin:0 auto 12px;">
            ${data.iconKey && appIcons[data.iconKey] ? appIcons[data.iconKey] : `<span style="font-size:24px;">⚡</span>`}
          </div>
          <h3 style="font-size:18px;font-weight:700;color:#0f172a;margin-bottom:6px;">${data.app}</h3>
          <p style="color:#64748b;font-size:14px;max-width:440px;margin:0 auto 16px;">${data.desc} · Launched instantly via global shortcut!</p>
          <div style="background:#f1f5f9;border:1px solid #e2e8f0;border-radius:10px;padding:12px 18px;color:#334155;max-width:480px;margin:0 auto;text-align:left;line-height:1.6;font-size:13px;">
            <strong>💡 Try Smart Ping-Pong</strong>: Press the same shortcut key again or click outside to bounce back to your previous window or hide the app!
          </div>
        </div>
      `;
    }

    function openFakeAppModal(char, data) {
      if (!fakeAppModal) return;
      const modSymbol = getModifierSymbol(currentModifier);
      if (fakeTitleIcon && data.iconKey && appIcons[data.iconKey]) {
        fakeTitleIcon.innerHTML = appIcons[data.iconKey];
      } else if (fakeTitleIcon) {
        fakeTitleIcon.innerHTML = `<span style="font-size:12px;font-weight:800;">${char}</span>`;
      }
      const appEnglishNames = {
        W: "WeChat",
        E: "Safari",
        Y: "Music",
        O: "Obsidian",
        P: "IINA",
        A: "Google Drive",
        D: "Surge",
        F: "Finder",
        G: "Chrome",
        H: "Ghostty",
        X: "Xcode"
      };
      const enAppName = appEnglishNames[char] || (data.app ? data.app.split(" ")[0] : char);
      if (fakeWindowAppName) {
        fakeWindowAppName.textContent = `${enAppName} · ${modSymbol} + ${char}`;
      }
      if (fakeWindowBody) {
        fakeWindowBody.innerHTML = renderAppWindowBody(char, data);
      }
      fakeAppModal.classList.add("open");
      isModalOpen = true;
      updateBodyScrollLock();
    }

    function closeFakeAppModal(reason) {
      if (!fakeAppModal) return;
      fakeAppModal.classList.remove("open");
      isModalOpen = false;
      updateBodyScrollLock();
    }

    function updateBodyScrollLock() {
      if (isModalOpen || isStatsOpen || isAssignOpen) {
        document.documentElement.classList.add("modal-open");
        document.body.classList.add("modal-open");
      } else {
        document.documentElement.classList.remove("modal-open");
        document.body.classList.remove("modal-open");
      }
    }

    if (closeFakeModalBtn) closeFakeModalBtn.addEventListener("click", () => closeFakeAppModal("close_btn"));
    if (fakeAppModal) {
      fakeAppModal.addEventListener("click", (e) => {
        if (e.target === fakeAppModal) closeFakeAppModal("backdrop");
      });
    }

    function openStatsModal() {
      if (!statsModal) return;
      const statsRowFKeys = document.querySelector("#statsRowFKeys");
      const statsRowNumKeys = document.querySelector("#statsRowNumKeys");
      const isFChecked = toggleFKeys && toggleFKeys.classList.contains("checked");
      const isNumChecked = toggleNumKeys && toggleNumKeys.classList.contains("checked");
      if (statsRowFKeys) statsRowFKeys.style.display = isFChecked ? "flex" : "none";
      if (statsRowNumKeys) statsRowNumKeys.style.display = isNumChecked ? "flex" : "none";
      statsModal.classList.add("open");
      isStatsOpen = true;
      updateBodyScrollLock();
    }

    function closeStatsModal() {
      if (!statsModal) return;
      statsModal.classList.remove("open");
      isStatsOpen = false;
      updateBodyScrollLock();
    }

    if (bottomStatsBtn) bottomStatsBtn.addEventListener("click", openStatsModal);
    if (wellStatsBtn) wellStatsBtn.addEventListener("click", openStatsModal);
    if (closeStatsModalBtn) closeStatsModalBtn.addEventListener("click", closeStatsModal);
    if (statsModal) {
      statsModal.addEventListener("click", (e) => {
        if (e.target === statsModal) closeStatsModal();
      });
    }
    function renderAssignRow(item, isRecommended, isSelected) {
      const dict = translationsData[currentLang] || translationsData["zh-Hans"];
      const activeClass = isSelected ? "active" : "";
      const recBadge = isRecommended ? `<span class="assign-pill-rec">${dict["assign.badge.recommended"] || "推荐"}</span>` : "";
      const svgIcon = item.iconKey && appIcons[item.iconKey] ? appIcons[item.iconKey] : "";
      return `
        <div class="assign-row-item ${activeClass}" data-app-id="${item.id}">
          <div class="assign-row-icon">${svgIcon}</div>
          <div class="assign-row-meta">
            <div class="assign-row-title">${item.app}</div>
            <div class="assign-row-bundle">${item.bundleId || item.desc}</div>
          </div>
          ${recBadge}
          <div class="assign-row-check">✓</div>
        </div>
      `;
    }

    function openAssignModal(char) {
      if (!assignAppModal) return;
      assignTargetKey = char;
      isAssignOpen = true;

      // Filter recommended apps:
      // Match recommendedKey or first letter of app name / key association
      const recApps = appLibrary.filter(item => {
        if (item.recommendedKey && item.recommendedKey.toUpperCase() === char.toUpperCase()) return true;
        if (char === "C" && item.id === "chrome") return true;
        if (char === "Y" && item.id === "music") return true;
        if (char === "P" && item.id === "iina") return true;
        if (item.app.toUpperCase().startsWith(char.toUpperCase())) return true;
        return false;
      });

      // Fallback recommended apps: chrome, music, iina or first 3
      const finalRecApps = recApps.length > 0 ? recApps : appLibrary.slice(0, 4);
      const recIds = new Set(finalRecApps.map(a => a.id));
      const allOtherApps = appLibrary.filter(a => !recIds.has(a.id));

      selectedAppItem = finalRecApps[0] || appLibrary[0];

      if (assignRecommendedLabel) {
        const dict = translationsData[currentLang] || translationsData["zh-Hans"];
        const template = dict["assign.section.recommended"] || `按键 ${char} 推荐`;
        assignRecommendedLabel.textContent = template.replace("{key}", char);
      }

      if (assignRecommendedList) {
        assignRecommendedList.innerHTML = finalRecApps.map(item =>
          renderAssignRow(item, true, item.id === selectedAppItem.id)
        ).join("");
      }

      if (assignAllList) {
        assignAllList.innerHTML = allOtherApps.map(item =>
          renderAssignRow(item, false, item.id === selectedAppItem.id)
        ).join("");
      }

      // Row selection event bindings
      assignAppModal.querySelectorAll(".assign-row-item").forEach(row => {
        row.addEventListener("click", () => {
          const appId = row.getAttribute("data-app-id");
          const found = appLibrary.find(a => a.id === appId);
          if (found) {
            selectedAppItem = found;
            assignAppModal.querySelectorAll(".assign-row-item").forEach(r => r.classList.remove("active"));
            row.classList.add("active");
          }
        });
        row.addEventListener("dblclick", () => {
          const appId = row.getAttribute("data-app-id");
          const found = appLibrary.find(a => a.id === appId);
          if (found) {
            selectedAppItem = found;
            commitAssignment();
          }
        });
      });

      assignAppModal.classList.add("open");
      updateBodyScrollLock();
    }

    function closeAssignModal() {
      if (!assignAppModal) return;
      assignAppModal.classList.remove("open");
      isAssignOpen = false;
      assignTargetKey = null;
      selectedAppItem = null;
      updateBodyScrollLock();
    }

    function commitAssignment() {
      if (!assignTargetKey || !selectedAppItem) {
        closeAssignModal();
        return;
      }
      const char = assignTargetKey;
      const appItem = selectedAppItem;

      appDictionary[char] = {
        app: appItem.app,
        iconKey: appItem.iconKey,
        desc: appItem.desc
      };

      const keyEl = document.querySelector(`.app-key[data-key="${char}"]`);
      if (keyEl) {
        renderKeyEl(keyEl, char, appDictionary[char]);
        keyEl.classList.add("active-focus", "key-pressed");
        setTimeout(() => keyEl.classList.remove("key-pressed"), 300);
      }
      const modSymbol = getModifierSymbol(currentModifier);
      showI18nToast("assign.toast.assigned", `已成功将 {app} 绑定至快捷键 {shortcut}`, {
        app: appItem.app,
        shortcut: `${modSymbol} + ${char}`,
        key: char
      });

      closeAssignModal();
    }

    if (assignSelectFileBtn) {
      assignSelectFileBtn.addEventListener("click", () => {
        if (selectedAppItem && assignTargetKey) {
          saveSelectedApp(assignTargetKey, selectedAppItem);
        }
      });
    }

    if (saveAssignModalBtn) {
      saveAssignModalBtn.addEventListener("click", () => {
        if (selectedAppItem && assignTargetKey) {
          saveSelectedApp(assignTargetKey, selectedAppItem);
        }
      });
    }

    if (cancelAssignModalBtn) cancelAssignModalBtn.addEventListener("click", closeAssignModal);
    if (assignAppModal) {
      assignAppModal.addEventListener("click", (e) => {
        if (e.target === assignAppModal) closeAssignModal();
      });
    }
    const windowSettingBtn = document.querySelector("#windowSettingBtn");
    if (windowSettingBtn) {
      windowSettingBtn.addEventListener("click", () => {
        showI18nToast("toast.settings", "偏好设置：可在下方开启调整模式，直接拖拽或点击互换按键");
      });
    }

    if (statsClearBtn) {
      statsClearBtn.addEventListener("click", () => {
        document.querySelectorAll(".stats-chiclet-key").forEach(k => {
          k.classList.remove("stats-heat-high", "stats-heat-med", "stats-heat-low");
        });
        const statsTotal = document.querySelector("#statsTotalCount");
        if (statsTotal) statsTotal.textContent = "0";
        const statsMaxVal = document.querySelector("#statsMaxVal");
        if (statsMaxVal) statsMaxVal.textContent = "0";
        const summary = document.querySelector("#statsSummaryText");
        if (summary) summary.textContent = "近七日 0 个快捷键有使用记录";
        const simSummary = document.querySelector("#simStatsSummaryText");
        if (simSummary) simSummary.textContent = "近七日 0 个快捷键有使用记录";
        showI18nToast("toast.statsCleared", "已清空使用记录统计");
      });
    }

    function renderKeyEl(el, char, data) {
      if (!el) return;
      if (data && data.app) {
        el.className = "app-key app-key-mapped";
        el.setAttribute("data-app", data.app);
        el.setAttribute("data-icon", data.iconKey || "");
        el.setAttribute("data-desc", data.desc || "");
        const svgHTML = data.iconKey && appIcons[data.iconKey] ? appIcons[data.iconKey] : "";
        el.innerHTML = `
          <span class="app-key-tag">${char}</span>
          <div class="app-icon-slot">
            <div class="app-squircle-icon">${svgHTML}</div>
          </div>
          <span class="adjust-delete-badge" data-key="${char}">×</span>
          <span class="adjust-hand-badge">👆</span>
        `;
        const delBtn = el.querySelector(".adjust-delete-badge");
        if (delBtn) {
          delBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            delete appDictionary[char];
            renderKeyEl(el, char, null);
            showI18nToast("toast.unassigned", `已取消按键 [${char}] 的绑定`, { key: char });
          });
        }
      } else {
        el.className = "app-key app-key-unmapped";
        el.removeAttribute("data-app");
        el.removeAttribute("data-icon");
        el.removeAttribute("data-desc");
        el.innerHTML = `<span class="unmapped-char">${char}</span>`;
      }
    }

    function executeMoveOrSwap(srcChar, tgtChar) {
      if (!srcChar || !tgtChar || srcChar === tgtChar) return;
      const srcEl = document.querySelector(`.app-key[data-key="${srcChar}"]`);
      const tgtEl = document.querySelector(`.app-key[data-key="${tgtChar}"]`);
      if (!srcEl || !tgtEl) return;

      const srcData = appDictionary[srcChar] ? { ...appDictionary[srcChar] } : null;
      const tgtData = appDictionary[tgtChar] ? { ...appDictionary[tgtChar] } : null;

      if (!srcData && !tgtData) {
        showI18nToast("toast.adjustBothUnassigned", "选中的两个按键均未分配应用");
        return;
      }
      if (srcData && tgtData) {
        // Swap
        appDictionary[srcChar] = tgtData;
        appDictionary[tgtChar] = srcData;
        renderKeyEl(srcEl, srcChar, tgtData);
        renderKeyEl(tgtEl, tgtChar, srcData);
        srcEl.classList.add("adjust-swap-anim");
        tgtEl.classList.add("adjust-swap-anim");
        setTimeout(() => {
          srcEl.classList.remove("adjust-swap-anim");
          tgtEl.classList.remove("adjust-swap-anim");
        }, 400);
        showI18nToast("toast.adjustSwapped", `已将「${srcData.app} (${srcChar})」与「${tgtData.app} (${tgtChar})」快捷键成功对调！`, {
          srcApp: srcData.app,
          srcKey: srcChar,
          tgtApp: tgtData.app,
          tgtKey: tgtChar
        });
      } else if (srcData && !tgtData) {
        // Move from src to tgt
        appDictionary[tgtChar] = srcData;
        delete appDictionary[srcChar];
        renderKeyEl(tgtEl, tgtChar, srcData);
        renderKeyEl(srcEl, srcChar, null);
        srcEl.classList.add("adjust-swap-anim");
        tgtEl.classList.add("adjust-swap-anim");
        setTimeout(() => {
          srcEl.classList.remove("adjust-swap-anim");
          tgtEl.classList.remove("adjust-swap-anim");
        }, 400);
        showI18nToast("toast.adjustMoved", `已将「${srcData.app}」成功移动到按键 [${tgtChar}]！`, {
          app: srcData.app,
          key: tgtChar
        });
      } else if (!srcData && tgtData) {
        // Move from tgt to src
        appDictionary[srcChar] = tgtData;
        delete appDictionary[tgtChar];
        renderKeyEl(srcEl, srcChar, tgtData);
        renderKeyEl(tgtEl, tgtChar, null);
        srcEl.classList.add("adjust-swap-anim");
        tgtEl.classList.add("adjust-swap-anim");
        setTimeout(() => {
          srcEl.classList.remove("adjust-swap-anim");
          tgtEl.classList.remove("adjust-swap-anim");
        }, 400);
        showI18nToast("toast.adjustMoved", `已将「${tgtData.app}」成功移动到按键 [${srcChar}]！`, {
          app: tgtData.app,
          key: srcChar
        });
      }
    }
    function isKeyRowEnabled(char) {
      if (!char) return false;
      const isFKey = /^F(1[0-2]|[1-9])$/i.test(char);
      const isNumKey = /^[0-9]$/.test(char);
      if (isFKey) {
        return toggleFKeys && toggleFKeys.classList.contains("checked");
      }
      if (isNumKey) {
        return toggleNumKeys && toggleNumKeys.classList.contains("checked");
      }
      return true;
    }

    function handleKeyClick(char, name, iconKey, desc) {
      // If row is disabled (e.g. number or F-key row toggled OFF), ignore normal launch
      if (!isKeyRowEnabled(char) && !isAdjustMode) {
        return;
      }
      if (isAdjustMode) {
        if (!adjustSourceKey) {
          if (!appDictionary[char]) {
            showI18nToast("toast.adjustSelectSource", "请先点击一个已有应用的按键，然后再点击/拖拽到目标按键");
            return;
          }
          adjustSourceKey = char;
          const keyEl = document.querySelector(`.app-key[data-key="${char}"]`);
          if (keyEl) keyEl.classList.add("adjust-selected");
          showI18nToast("toast.adjustSelected", `已选中「${(appDictionary[char] || {}).app || char} (${char})」，请点击或拖拽到另一个按键对调/移动`, {
            app: (appDictionary[char] || {}).app || char,
            key: char
          });
          return;
        }

        if (adjustSourceKey === char) {
          adjustSourceKey = null;
          const keyEl = document.querySelector(`.app-key[data-key="${char}"]`);
          if (keyEl) keyEl.classList.remove("adjust-selected");
          showI18nToast("toast.adjustCanceled", "已取消按键选择");
          return;
        }

        const srcChar = adjustSourceKey;
        adjustSourceKey = null;
        document.querySelectorAll(".app-key").forEach(k => k.classList.remove("adjust-selected"));
        executeMoveOrSwap(srcChar, char);
        return;
      }

      // If key is unmapped, open 1:1 Assign App Sheet!
      if (!appDictionary[char]) {
        openAssignModal(char);
        return;
      }

      const data = appDictionary[char];
      const keyEl = document.querySelector(`.app-key[data-key="${char}"]`);

      // Normal Launch Mode
      document.querySelectorAll(".app-key").forEach(k => k.classList.remove("active-focus", "key-pressed"));
      if (keyEl) {
        keyEl.classList.add("active-focus", "key-pressed");
        setTimeout(() => keyEl.classList.remove("key-pressed"), 180);
      }

      // Ping-Pong check: If modal is already open for this key, bounce back & close!
      if (isModalOpen && activeKeyChar === char) {
        closeFakeAppModal("pingpong");
        showI18nToast("toast.pingpong", `⚡ Ping-Pong 弹跳已触发：再次按下 ${getModifierSymbol(currentModifier)} + ${char}，已切回上一个工作窗口`, {
          shortcut: `${getModifierSymbol(currentModifier)} + ${char}`
        });
        activeKeyChar = null;
        return;
      }

      activeKeyChar = char;
      openFakeAppModal(char, data);
    }
    function initKeyInteractions() {
      document.querySelectorAll(".app-key").forEach(el => {
        el.addEventListener("click", () => {
          const char = el.getAttribute("data-key");
          const app = el.getAttribute("data-app") || `未分配按键 (${char})`;
          const icon = el.getAttribute("data-icon") || "";
          const desc = el.getAttribute("data-desc") || "当前按键未绑定应用，可拖拽或调整进行分配。";
          handleKeyClick(char, app, icon, desc);
        });

        // Delete button inside initial mapped keys
        const delBtn = el.querySelector(".adjust-delete-badge");
        if (delBtn) {
          delBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const char = el.getAttribute("data-key");
            delete appDictionary[char];
            renderKeyEl(el, char, null);
            showI18nToast("toast.unassigned", `已取消按键 [${char}] 的绑定`, { key: char });
          });
        }

        // HTML5 Drag and Drop events
        el.addEventListener("dragstart", (e) => {
          if (!isAdjustMode) return;
          draggedKeyChar = el.getAttribute("data-key");
          el.classList.add("dragging-key");
          e.dataTransfer.setData("text/plain", draggedKeyChar);
        });

        el.addEventListener("dragend", () => {
          el.classList.remove("dragging-key");
          document.querySelectorAll(".app-key").forEach(k => k.classList.remove("drop-target-hover"));
        });

        el.addEventListener("dragover", (e) => {
          if (!isAdjustMode) return;
          e.preventDefault();
          el.classList.add("drop-target-hover");
        });

        el.addEventListener("dragleave", () => {
          el.classList.remove("drop-target-hover");
        });

        el.addEventListener("drop", (e) => {
          if (!isAdjustMode) return;
          e.preventDefault();
          el.classList.remove("drop-target-hover");
          const tgtChar = el.getAttribute("data-key");
          if (draggedKeyChar && tgtChar) {
            executeMoveOrSwap(draggedKeyChar, tgtChar);
          }
          draggedKeyChar = null;
        });
      });
    }

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (isStatsOpen) closeStatsModal();
        if (isModalOpen) closeFakeAppModal("escape");
        return;
      }

      const pressedKey = e.key.toUpperCase();
      if (appDictionary[pressedKey] && isKeyRowEnabled(pressedKey)) {
        const keyData = appDictionary[pressedKey];
        handleKeyClick(pressedKey, keyData.app, keyData.iconKey, keyData.desc);
      }
    });

    // Modifier Pill Buttons
    document.querySelectorAll(".mod-app-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".mod-app-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentModifier = btn.getAttribute("data-mod") || "Option";
        showI18nToast("toast.modifierChanged", `已切换修饰键为 ${btn.querySelector(".mod-text").textContent}`, {
          mod: btn.querySelector(".mod-text").textContent
        });
      });
    });

    // Adjust Mode Button
    const adjustModeBtn = document.querySelector("#adjustModeBtn");
    const adjustBtnIcon = document.querySelector("#adjustBtnIcon");
    const adjustBtnText = document.querySelector("#adjustBtnText");
    const wellVersionInfo = document.querySelector("#wellVersionInfo");
    const appKeyboardGrid = document.querySelector("#appKeyboardGrid");

    if (adjustModeBtn) {
      adjustModeBtn.addEventListener("click", () => {
        isAdjustMode = !isAdjustMode;
        const dict = window.siteTranslations[currentLang] || window.siteTranslations["zh-Hans"];

        if (isAdjustMode) {
          adjustModeBtn.classList.add("well-adjust-btn-done");
          if (adjustBtnIcon) adjustBtnIcon.textContent = "✓";
          if (adjustBtnText) adjustBtnText.textContent = dict["well.adjustDone"] || "完成";
          if (wellVersionInfo) {
            wellVersionInfo.innerHTML = `<span>💡 ${dict["well.adjustHintShort"] || "拖动按键或依次点击以对调"}</span>`;
          }
          if (appKeyboardGrid) appKeyboardGrid.classList.add("adjust-mode-active");
          document.querySelectorAll(".app-key").forEach(k => k.setAttribute("draggable", "true"));
          showI18nToast("toast.adjustStarted", "已开启调整模式：拖动已绑定的按键即可移动或交换；也可以依次点击原按键和目标按键。");
        } else {
          adjustModeBtn.classList.remove("well-adjust-btn-done");
          if (adjustBtnIcon) adjustBtnIcon.textContent = "↻";
          if (adjustBtnText) adjustBtnText.textContent = dict["well.adjust"] || "调整";
          if (wellVersionInfo) {
            wellVersionInfo.innerHTML = `
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span data-i18n="well.version">${dict["well.version"] || "版本 1.3.18 (33)"}</span>
            `;
          }
          if (appKeyboardGrid) appKeyboardGrid.classList.remove("adjust-mode-active");
          document.querySelectorAll(".app-key").forEach(k => {
            k.removeAttribute("draggable");
            k.classList.remove("adjust-selected", "drop-target-hover", "dragging-key");
          });
          adjustSourceKey = null;
          showI18nToast("toast.adjustEnded", "已退出调整模式");
        }
      });
    }

    // Toggle Expandable Rows
    const toggleFKeys = document.querySelector("#toggleFKeys");
    const rowFKeys = document.querySelector("#rowFKeys");
    if (toggleFKeys && rowFKeys) {
      toggleFKeys.addEventListener("click", () => {
        const isChecked = toggleFKeys.classList.toggle("checked");
        toggleFKeys.setAttribute("aria-checked", String(isChecked));
        rowFKeys.classList.toggle("active", isChecked);
        const statsRowFKeys = document.querySelector("#statsRowFKeys");
        if (statsRowFKeys) statsRowFKeys.style.display = isChecked ? "flex" : "none";
        if (isChecked) {
          showI18nToast("toast.fkeysEnabled", "已启用 F 功能键行");
        } else {
          if (activeKeyChar && /^F(1[0-2]|[1-9])$/i.test(activeKeyChar)) {
            closeFakeAppModal("row_disabled");
            activeKeyChar = null;
          }
          showI18nToast("toast.fkeysDisabled", "已隐藏 F 功能键行（该行快捷键已暂停）");
        }
      });
    }

    const toggleNumKeys = document.querySelector("#toggleNumKeys");
    const rowNumKeys = document.querySelector("#rowNumKeys");
    if (toggleNumKeys && rowNumKeys) {
      toggleNumKeys.addEventListener("click", () => {
        const isChecked = toggleNumKeys.classList.toggle("checked");
        toggleNumKeys.setAttribute("aria-checked", String(isChecked));
        rowNumKeys.classList.toggle("active", isChecked);
        const statsRowNumKeys = document.querySelector("#statsRowNumKeys");
        if (statsRowNumKeys) statsRowNumKeys.style.display = isChecked ? "flex" : "none";
        if (isChecked) {
          showI18nToast("toast.numkeysEnabled", "已启用数字键行");
        } else {
          if (activeKeyChar && /^[0-9]$/.test(activeKeyChar)) {
            closeFakeAppModal("row_disabled");
            activeKeyChar = null;
          }
          showI18nToast("toast.numkeysDisabled", "已隐藏数字键行（该行快捷键已暂停）");
        }
      });
    }

    function showI18nToast(key, fallback, params = {}) {
      const dict = window.siteTranslations[currentLang] || window.siteTranslations["zh-Hans"] || {};
      let msg = dict[key] || fallback;
      for (const [k, v] of Object.entries(params)) {
        msg = msg.replaceAll(`{${k}}`, v);
      }
      showToast(msg);
    }
    let toastTimer = null;
    const globalToast = document.querySelector("#globalToast");
    if (globalToast) {
      // Hover to pause auto-dismissal
      globalToast.addEventListener("mouseenter", () => {
        if (toastTimer) clearTimeout(toastTimer);
      });
      // Resume dismissal after mouse leaves
      globalToast.addEventListener("mouseleave", () => {
        if (globalToast.classList.contains("show")) {
          toastTimer = setTimeout(() => globalToast.classList.remove("show"), 2000);
        }
      });
      // Click to dismiss immediately if finished reading
      globalToast.addEventListener("click", () => {
        if (toastTimer) clearTimeout(toastTimer);
        globalToast.classList.remove("show");
      });
    }

    function showToast(msg) {
      const toast = document.querySelector("#globalToast");
      if (!toast) return;
      if (toastTimer) clearTimeout(toastTimer);
      toast.querySelector("span").textContent = msg;
      toast.classList.add("show");
      
      // Dynamic reading time: minimum 4.2s, plus 120ms per character for longer tips
      const duration = Math.max(4200, Math.min(8000, (msg.length || 10) * 120 + 2200));
      toastTimer = setTimeout(() => {
        toast.classList.remove("show");
      }, duration);
    }
    function setupCopyButtons() {
      document.querySelectorAll("[data-copy]").forEach(btn => {
        btn.addEventListener("click", async () => {
          const text = btn.getAttribute("data-copy");
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            showI18nToast("toast.copied", "已复制到剪贴板：" + text, { text });
          } catch (e) {
            showI18nToast("toast.copyFallback", "已选中命令，请按 ⌘+C 复制");
          }
        });
      });
    }

    function applyLanguage(lang) {
      currentLang = lang;
      const dict = window.siteTranslations[lang] || window.siteTranslations["zh-Hans"];
      if (!dict) return;

      document.documentElement.lang = lang;
      localStorage.setItem("keylaunch_lang", lang);

      document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (dict[key] !== undefined) {
          el.textContent = dict[key];
          if (dict[key] === "") {
            el.style.display = "none";
          } else {
            el.style.display = "";
          }
        }
      });

      document.querySelectorAll("[data-i18n-html]").forEach(el => {
        const key = el.getAttribute("data-i18n-html");
        if (dict[key] !== undefined) {
          el.innerHTML = dict[key];
          if (dict[key] === "") {
            el.style.display = "none";
          } else {
            el.style.display = "";
          }
        }
      });

      if (dict["meta.title"]) document.title = dict["meta.title"];
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc && dict["meta.description"]) metaDesc.setAttribute("content", dict["meta.description"]);

      // Update adjust button text based on current mode
      if (adjustBtnText) {
        adjustBtnText.textContent = isAdjustMode ? (dict["well.adjustDone"] || "完成") : (dict["well.adjust"] || "调整");
      }
    }

    function initLanguage() {
      const saved = localStorage.getItem("keylaunch_lang");
      let lang = "zh-Hans";
      if (saved && supportedLanguages.includes(saved)) {
        lang = saved;
      } else {
        const navLang = (navigator.language || navigator.userLanguage || "zh-Hans").toLowerCase();
        if (navLang.startsWith("zh-tw") || navLang.startsWith("zh-hk")) lang = "zh-Hant";
        else if (navLang.startsWith("zh")) lang = "zh-Hans";
        else if (navLang.startsWith("ja")) lang = "ja";
        else if (navLang.startsWith("ko")) lang = "ko";
        else lang = "en";
      }

      if (languageSelect) {
        languageSelect.value = lang;
        languageSelect.addEventListener("change", (e) => {
          applyLanguage(e.target.value);
        });
      }
      applyLanguage(lang);
    }

    // Scroll Reveal Observer
    function initScrollReveal() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
    }

    // Installation Tabs
    function initInstallTabs() {
      const instTabBtns = document.querySelectorAll(".inst-tab-btn");
      instTabBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const tabName = btn.getAttribute("data-tab");
          if (!tabName) return;
          
          instTabBtns.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          
          document.querySelectorAll(".tab-pane").forEach(pane => {
            pane.classList.remove("active");
          });
          
          const activePane = document.querySelector(`#pane-${tabName}`);
          if (activePane) {
            activePane.classList.add("active");
          }
        });
      });
    }

    // Init All
    function initAll() {
      initKeyInteractions();
      initInstallTabs();
      setupCopyButtons();
      initLanguage();
      initScrollReveal();
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  </script>
</body>
</html>
