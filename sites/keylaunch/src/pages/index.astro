---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SpeedCompare from '../components/SpeedCompare.astro';
import BentoFeatures from '../components/BentoFeatures.astro';
import TechnicalDNA from '../components/TechnicalDNA.astro';
import Install from '../components/Install.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { defaultAppMap, appIcons, allAppLibrary } from '../data/keyboard.js';
import { translations } from '../data/translations.js';
---

<!DOCTYPE html>
<html lang="zh-Hans">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>KeyLaunch (键启) - macOS 原生单键极速直达与窗口调度神器</title>
  <meta name="description" content="专为 macOS 深度用户打造的原生快捷键直达神器。单键物理映射 0.1 秒唤起，智能 Ping-Pong 弹跳去回，0.0% 闲置 CPU，纯原生 Swift 极速体验。" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="https://keylaunch.lanrenwen.com" />

  <!-- Open Graph -->
  <meta property="og:title" content="KeyLaunch (键启) - macOS 原生单键极速直达与窗口调度神器" />
  <meta property="og:description" content="专为 macOS 深度用户打造的原生快捷键直达神器。单键物理映射 0.1 秒唤起，智能 Ping-Pong 弹跳去回。" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://keylaunch.lanrenwen.com" />
  <meta property="og:image" content="https://keylaunch.lanrenwen.com/og-image.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="KeyLaunch (键启) - macOS 原生快捷键直达" />
  <meta name="twitter:description" content="0.1 秒单键直达目标应用，智能 Ping-Pong 弹跳调度，原生 Swift 极致轻巧。" />

  <!-- Schema.org SoftwareApplication -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "KeyLaunch",
    "alternateName": "键启",
    "operatingSystem": "macOS 12.0+",
    "applicationCategory": "UtilitiesApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "macOS 原生单键极速直达与窗口调度神器",
    "author": {
      "@type": "Organization",
      "name": "Lanrenwen Studio",
      "url": "https://lanrenwen.com"
    }
  }
  </script>
</head>
<body>
  <a class="skip-link" href="#top">Skip to content</a>
  <Header />
  <main id="top">
    <Hero />
    <SpeedCompare />
    <BentoFeatures />
    <TechnicalDNA />
    <Install />
    <FAQ />
  </main>
  <Footer />

  <script>
    import { translations } from '../data/translations.js';
    import { defaultAppMap, appIcons, allAppLibrary } from '../data/keyboard.js';

    window.siteTranslations = translations;
    const translationsData = translations;
    const supportedLanguages = ["zh-Hans", "zh-Hant", "en", "ja", "ko"];
    const languageSelect = document.querySelector("#languageSelect");

    // Dynamic app dictionary
    const appDictionary = { ...defaultAppMap };
    const appLibrary = allAppLibrary;
    let currentModifier = "Option";
    let activeKeyChar = null;
    let isModalOpen = false;
    let isStatsOpen = false;
    let isAdjustMode = false;
    let adjustSourceKey = null;
    let draggedKeyChar = null;
    let currentLang = "zh-Hans";

    // Fake Modal Elements
    const fakeAppModal = document.querySelector("#fakeAppModal");
    const fakeTitleIcon = document.querySelector("#fakeTitleIcon");
    const fakeWindowAppName = document.querySelector("#fakeWindowAppName");
    const fakeWindowBody = document.querySelector("#fakeWindowBody");
    const closeFakeModalBtn = document.querySelector("#closeFakeModalBtn");

    // Stats Modal Elements
    const statsModal = document.querySelector("#statsModal");
    const bottomStatsBtn = document.querySelector("#bottomStatsBtn");
    const wellStatsBtn = document.querySelector("#wellStatsBtn");
    const closeStatsModalBtn = document.querySelector("#closeStatsModalBtn");
    const statsClearBtn = document.querySelector("#statsClearBtn");
    const statsSummaryText = document.querySelector("#statsSummaryText");
    // Assign Modal Elements (1:1 macOS Native Sheet)
    const assignAppModal = document.querySelector("#assignAppModal");
    const assignRecommendedLabel = document.querySelector("#assignRecommendedLabel");
    const assignRecommendedList = document.querySelector("#assignRecommendedList");
    const assignAllList = document.querySelector("#assignAllList");
    const cancelAssignModalBtn = document.querySelector("#cancelAssignModalBtn");
    const saveAssignModalBtn = document.querySelector("#saveAssignModalBtn");
    const assignSelectFileBtn = document.querySelector("#assignSelectFileBtn");

    let isAssignOpen = false;
    let assignTargetKey = null;
    let selectedAppItem = null;
    function getModifierSymbol(mod) {
      if (mod === "Command") return "⌘";
      if (mod === "Control") return "⌃";
      return "⌥";
    }

    function renderAppWindowBody(char, data) {
      const icon = data.iconKey || "";
      if (icon === "wechat") {
        return `
          <div class="fake-wechat-layout">
            <div class="fake-wechat-nav">
              <div class="fake-wechat-avatar">KW</div>
              <div class="fake-wechat-icon active">💬</div>
              <div class="fake-wechat-icon">👥</div>
              <div class="fake-wechat-icon">🧭</div>
              <div class="fake-wechat-icon" style="margin-top:auto;">⚙️</div>
            </div>
            <div class="fake-wechat-list">
              <div class="fake-chat-item active">
                <div class="fake-avatar" style="background:#07c160;color:#fff;">👥</div>
                <div class="fake-chat-meta">
                  <div class="fake-chat-name">Studio Core Team</div>
                  <div class="fake-chat-last">⌥+W opens instantly, hit Enter to send!</div>
                </div>
              </div>
              <div class="fake-chat-item">
                <div class="fake-avatar">📁</div>
                <div class="fake-chat-meta">
                  <div class="fake-chat-name">File Transfer</div>
                  <div class="fake-chat-last">[File] KeyLaunch_Release.dmg</div>
                </div>
              </div>
              <div class="fake-chat-item">
                <div class="fake-avatar">📰</div>
                <div class="fake-chat-meta">
                  <div class="fake-chat-name">Official Channel</div>
                  <div class="fake-chat-last">KeyLaunch v1.3.18 update notes</div>
                </div>
              </div>
            </div>
            <div class="fake-wechat-chat">
              <div class="fake-wechat-chat-header">Studio Core Team (4)</div>
              <div class="fake-bubble">Just pressed ⌥+W to reply in a split second, so smooth!</div>
              <div class="fake-bubble fake-bubble-green">Hit ⌥+W again to instantly bounce back to Xcode without breaking flow!</div>
              <div class="fake-wechat-input-area">
                <div class="fake-wechat-tools">😀 ✂️ 📁 🎙️</div>
                <div class="fake-wechat-input-box">
                  <span class="fake-typing-text">Awesome! Setting this up for the whole team~</span>
                  <button type="button" class="fake-send-btn">Send (↵)</button>
                </div>
              </div>
            </div>
          </div>
        `;
      }
      if (icon === "safari") {
        return `
          <div class="fake-safari-layout">
            <div class="fake-safari-toolbar">
              <div class="fake-safari-nav-btns">
                <span class="fake-nav-arrow">‹</span>
                <span class="fake-nav-arrow">›</span>
                <span class="fake-sidebar-icon">◫</span>
              </div>
              <div class="fake-safari-url-bar">
                <span class="fake-url-lock">🔒</span>
                <span class="fake-url-domain">apple.com/macbook-pro</span>
                <span class="fake-url-reload">↻</span>
              </div>
              <div class="fake-safari-actions">
                <span>􀈂</span>
                <span>＋</span>
                <span>􀐚</span>
              </div>
            </div>
            <div class="fake-safari-tabbar">
              <div class="fake-safari-tab active">
                <span class="tab-fav"></span>
                <span>MacBook Pro - Apple</span>
                <span class="tab-close">✕</span>
              </div>
              <div class="fake-safari-tab">
                <span class="tab-fav">🐙</span>
                <span>GitHub - LanrenwenStudio</span>
              </div>
            </div>
            <div class="fake-safari-page">
              <div class="safari-hero-banner">
                <span class="safari-sub">Mind-blowing. Head-turning.</span>
                <h2 class="safari-heading">MacBook Pro</h2>
                <p class="safari-subdesc">Supercharged by M4, M4 Pro, and M4 Max chips.</p>
                <div class="safari-cta-row">
                  <span class="safari-btn-blue">Learn more</span>
                  <span class="safari-btn-link">Buy &gt;</span>
                </div>
              </div>
              <div class="safari-favs-row">
                <div class="safari-fav-item"><div class="s-fav-icon"></div><span>Apple</span></div>
                <div class="safari-fav-item"><div class="s-fav-icon" style="background:#24292e;color:#fff;">🐙</div><span>GitHub</span></div>
                <div class="safari-fav-item"><div class="s-fav-icon" style="background:#ff0000;color:#fff;">▶</div><span>YouTube</span></div>
                <div class="safari-fav-item"><div class="s-fav-icon" style="background:#00a1d6;color:#fff;">📺</div><span>Bilibili</span></div>
              </div>
            </div>
          </div>
        `;
      }
      if (icon === "finder") {
        return `
          <div class="fake-finder-layout">
            <div class="fake-finder-sidebar">
              <div class="fake-side-header">FAVORITES</div>
              <div class="fake-side-item"><span>📡</span> AirDrop</div>
              <div class="fake-side-item active"><span>📂</span> Applications</div>
              <div class="fake-side-item"><span>🖥️</span> Desktop</div>
              <div class="fake-side-item"><span>📄</span> Documents</div>
              <div class="fake-side-item"><span>⬇️</span> Downloads</div>
              <div class="fake-side-header">ICLOUD</div>
              <div class="fake-side-item"><span>☁️</span> iCloud Drive</div>
            </div>
            <div class="fake-finder-main">
              <div class="fake-finder-topbar">
                <div class="finder-path-trail">Macintosh HD &gt; Applications</div>
                <div class="finder-view-modes">⊞ ☰ ☷ ☵</div>
              </div>
              <div class="fake-finder-grid">
                <div class="fake-file-card finder-card-active">
                  <div class="fake-file-icon">⚡</div>
                  <div class="fake-file-name">KeyLaunch.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">🧭</div>
                  <div class="fake-file-name">Safari.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">👻</div>
                  <div class="fake-file-name">Ghostty.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">🛠️</div>
                  <div class="fake-file-name">Xcode.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">💎</div>
                  <div class="fake-file-name">Obsidian.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">💬</div>
                  <div class="fake-file-name">WeChat.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">🌐</div>
                  <div class="fake-file-name">Chrome.app</div>
                </div>
                <div class="fake-file-card">
                  <div class="fake-file-icon">🎵</div>
                  <div class="fake-file-name">Music.app</div>
                </div>
              </div>
            </div>
          </div>
        `;
      }
      if (icon === "ghostty" || icon === "terminal") {
        return `
          <div class="fake-ghostty-layout">
            <div class="fake-ghostty-topbar">
              <span>ghostty — zsh — 80×24 (Apple Silicon M4)</span>
            </div>
            <div class="fake-ghostty-screen">
              <div class="term-line"><span class="term-user">kevin@MacBook-Pro</span> <span class="term-path">~</span> <span class="term-prompt">%</span> keylaunch --version</div>
              <div class="term-line term-dim">KeyLaunch v1.3.18 (universal) · Native Swift Architecture</div>
              <div class="term-line" style="margin-top:6px;"><span class="term-user">kevin@MacBook-Pro</span> <span class="term-path">~</span> <span class="term-prompt">%</span> keylaunch stats --summary</div>
              <div class="term-line term-success">[✓] KeyLaunch Daemon: Active (PID 49201 · 0.0% CPU · 8.2MB RAM)</div>
              <div class="term-line term-success">[✓] Modifier: Option (⌥) · Ping-Pong: Enabled</div>
              <div class="term-line term-info">[ℹ] Active Shortcut Mappings: 11 keys registered</div>
              <div class="term-line term-info">[ℹ] Top 1 App Today: Ghostty (⌥ + G) — 42 launches</div>
              <div class="term-line" style="margin-top:10px;"><span class="term-user">kevin@MacBook-Pro</span> <span class="term-path">~</span> <span class="term-prompt">%</span> <span class="term-cursor">█</span></div>
            </div>
          </div>
        `;
      }
      if (icon === "xcode") {
        return `
          <div class="fake-xcode-layout">
            <div class="fake-xcode-topbar">
              <span class="xcode-status-pill">✓ Build Succeeded</span>
              <span class="xcode-target">KeyLaunch &gt; My Mac (Designed for Apple Silicon)</span>
            </div>
            <div class="fake-xcode-body">
              <div class="fake-xcode-nav">
                <div class="xc-nav-title">📁 KeyLaunch</div>
                <div class="xc-nav-item">📁 Sources</div>
                <div class="xc-nav-item active">📄 HotKeyManager.swift</div>
                <div class="xc-nav-item">📄 AppWindow.swift</div>
                <div class="xc-nav-item">📄 PingPongEngine.swift</div>
              </div>
              <div class="fake-xcode-editor">
                <div class="xc-code-line"><span class="xc-kwd">import</span> <span class="xc-type">Cocoa</span></div>
                <div class="xc-code-line"><span class="xc-kwd">import</span> <span class="xc-type">Carbon</span></div>
                <div class="xc-code-line">&nbsp;</div>
                <div class="xc-code-line"><span class="xc-comment">/// Instant Hotkey Dispatcher &amp; Ping-Pong Engine</span></div>
                <div class="xc-code-line"><span class="xc-kwd">final class</span> <span class="xc-type">HotKeyManager</span>: <span class="xc-type">ObservableObject</span> {</div>
                <div class="xc-code-line">&nbsp;&nbsp;<span class="xc-kwd">static let</span> shared = <span class="xc-type">HotKeyManager</span>()</div>
                <div class="xc-code-line">&nbsp;&nbsp;<span class="xc-kwd">func</span> <span class="xc-func">dispatch</span>(key: <span class="xc-type">KeyCode</span>) {</div>
                <div class="xc-code-line">&nbsp;&nbsp;&nbsp;&nbsp;<span class="xc-kwd">if</span> isFrontmost(key) {</div>
                <div class="xc-code-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;bounceBackOrHide(key) <span class="xc-comment">// Smart Ping-Pong</span></div>
                <div class="xc-code-line">&nbsp;&nbsp;&nbsp;&nbsp;} <span class="xc-kwd">else</span> {</div>
                <div class="xc-code-line">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;bringToFront(key) <span class="xc-comment">// 0.1s instant launch</span></div>
                <div class="xc-code-line">&nbsp;&nbsp;&nbsp;&nbsp;}</div>
                <div class="xc-code-line">&nbsp;&nbsp;}</div>
                <div class="xc-code-line">}</div>
              </div>
            </div>
          </div>
        `;
      }
      if (icon === "obsidian") {
        return `
          <div class="fake-obsidian-layout">
            <div class="fake-obsidian-nav">
              <div class="obs-nav-head">📁 Personal Vault</div>
              <div class="obs-nav-file">📄 2026-08-17.md</div>
              <div class="obs-nav-file active">📄 KeyLaunch Muscle Memory Flow.md</div>
              <div class="obs-nav-file">📄 Shortcut Topology Map.md</div>
            </div>
            <div class="fake-obsidian-content">
              <h1 class="obs-title"># Why Single-Key Physical Mapping Saves Flow?</h1>
              <blockquote class="obs-quote">Eliminate ⌘+Tab cycling and Spotlight search typing overhead to build pure fingertip muscle memory.</blockquote>
              <h2 class="obs-h2">## Core Shortcut Layout</h2>
              <ul class="obs-list">
                <li><span class="obs-cb">☑</span> <strong>⌥ + G</strong>: Terminal (Instant compile &amp; run)</li>
                <li><span class="obs-cb">☑</span> <strong>⌥ + W</strong>: WeChat (Reply and hide immediately)</li>
                <li><span class="obs-cb">☑</span> <strong>⌥ + O</strong>: Obsidian (Capture thoughts on the fly)</li>
              </ul>
              <div class="obs-tags">
                <span class="obs-tag">#productivity</span>
                <span class="obs-tag">#flow</span>
                <span class="obs-tag">#macos</span>
              </div>
            </div>
          </div>
        `;
      }
      if (icon === "chrome") {
        return `
          <div class="fake-chrome-layout">
            <div class="fake-chrome-tabbar">
              <div class="chrome-tab active">
                <span class="chrome-tab-fav">🔍</span>
                <span>Google</span>
                <span class="chrome-tab-close">✕</span>
              </div>
              <div class="chrome-tab">
                <span class="chrome-tab-fav">⚡</span>
                <span>KeyLaunch Official</span>
