---
---
<header class="site-header">
  <div class="shell nav-inner">
    <a class="brand" href="#top" aria-label="ClipBar">
      <img src="/assets/clipbar-icon-128.webp" alt="ClipBar Logo" width="32" height="32" decoding="async" />
      <span>ClipBar</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      <a href="#simulator" data-i18n="nav.simulator">面板演示</a>
      <a href="#providers" data-i18n="nav.providers">监控渠道</a>
      <a href="#features" data-i18n="nav.features">特性说明</a>
      <a href="#quickstart" data-i18n="nav.quickstart">快速配置</a>
      <a href="#install" data-i18n="nav.install">安装方式</a>
      <a href="#faq" data-i18n="nav.faq">常见问题</a>
    </nav>
    <div class="nav-actions">
      <label class="language-picker">
        <select id="languageSelect" aria-label="Language / 语言切换">
          <option value="zh">简体中文</option>
          <option value="en">English</option>
        </select>
      </label>
      <button type="button" class="nav-brew-btn" data-copy="brew install --cask LanrenwenStudio/apps/clipbar" aria-label="复制 Homebrew 安装命令">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span data-i18n="nav.brew">brew install</span>
      </button>
    </div>
  </div>
</header>
