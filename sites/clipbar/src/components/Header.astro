---
---
<header class="site-header">
  <div class="shell nav-inner">
    <a class="brand" href="#top" aria-label="ClipBar">
      <img src="/assets/clipbar-app-icon-128.webp" alt="ClipBar Logo" width="32" height="32" decoding="async" />
      <span>ClipBar</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      <a href="#simulator" data-i18n="nav.simulator">面板演示</a>
      <a href="#providers" data-i18n="nav.providers">监控渠道</a>
      <a href="#features" data-i18n="nav.features">特性说明</a>
      <a href="#quickstart" data-i18n="nav.quickstart">快速配置</a>
      <a href="#install" data-i18n="nav.install">安装方式</a>
      <a href="#faq" data-i18n="nav.faq">常见问题</a>
    </nav>
    <div class="nav-actions">
      <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="切换明暗色彩模式" title="切换明暗色彩模式">
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button type="button" class="lang-toggle-btn" id="langToggleBtn" aria-label="切换中英文语言 / Switch Language" title="切换中英文语言 / Switch Language">
        <span class="lang-toggle-text" id="langToggleText">EN</span>
      </button>
      <a href="https://github.com/LanrenwenStudio/ClipBar" target="_blank" rel="noopener noreferrer" class="nav-github-btn" aria-label="GitHub 开源项目" title="GitHub 开源项目">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <button type="button" class="nav-brew-btn" data-copy="brew install --cask LanrenwenStudio/apps/clipbar" aria-label="复制 Homebrew 安装命令">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span data-i18n="nav.brew">brew install</span>
      </button>
    </div>
  </div>
</header>
