---
import Simulator from './Simulator.astro';
---
<section class="hero" id="top">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <div class="eyebrow" data-i18n="hero.eyebrow">macOS 菜单栏小工具</div>
      <h1 data-i18n="hero.title">在 macOS 菜单栏查看<br><span>CLIProxyAPI 订阅额度。</span></h1>
      <p class="hero-lede" data-i18n="hero.lede">专为本地运行 CLIProxyAPI 的开发者打造。只读连接本地管理接口，状态栏实时显示 Codex、Claude、Grok 等订阅账号的 5h / 7d 剩余额度与重置倒计时，不再写代码写到一半突然断流。</p>
      
      <div class="hero-cta-group">
        <div class="hero-buttons">
          <a class="btn-primary" href="https://github.com/LanrenwenStudio/ClipBar/releases/latest/download/ClipBar.dmg" id="downloadDmgBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span data-i18n="hero.downloadDmg">直接下载 ClipBar.dmg</span>
          </a>
        </div>

        <button type="button" class="btn-brew" data-copy="brew install --cask LanrenwenStudio/apps/clipbar" aria-label="复制 Homebrew 命令" title="点击复制完整 Homebrew 安装命令">
          <code>brew install --cask clipbar</code>
          <span class="copy-icon-btn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span data-i18n="hero.copy">Copy</span>
          </span>
        </button>

        <div class="hero-badges" data-i18n="hero.badges">
          支持 macOS 14 Sonoma+ · 100% 本机只读 · 零云端依赖
        </div>
      </div>
    </div>

    <!-- Simulator Showcase -->
    <Simulator />
  </div>
</section>
